{
  "name": "nc-tools",
  "version": "0.3.0",
  "description": "Typed machine API for coding agents — terminal-free Rust kernel, MCP server, agent loop, benchmark.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "cargo build --release -p nct-mcp -p nct-agent",
    "test:rust": "cargo test",
    "test:node": "node --test \"tests/**/*.test.mjs\"",
    "test": "npm run test:node && npm run test:rust",
    "conform": "node tools/conformance.mjs",
    "crossaudit": "node tools/crossaudit.mjs",
    "audit": "node tools/audit.mjs",
    "golden": "node tools/golden.mjs",
    "verify:verifiers": "node bench/validate-verifiers.mjs",
    "install:bin": "node tools/install-bin.mjs"
  },
  "bin": {
    "nc-tools-mcp": "bin/nc-tools-mcp.mjs"
  }
}
