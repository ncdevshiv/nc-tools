{
  "name": "nc-tools",
  "version": "0.2.0",
  "description": "Typed machine API for coding agents — terminal-free kernel, MCP server, agent loop, benchmark.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:rust": "cargo test --manifest-path rust/Cargo.toml",
    "audit": "node tools/audit.mjs",
    "build:rust": "cargo build --release --manifest-path rust/Cargo.toml -p nct-mcp",
    "install:bin": "node tools/install-bin.mjs",
    "conform": "node tools/conformance.mjs",
    "golden": "node tools/golden.mjs",
    "bench": "node benchmark/harness.mjs"
  },
  "bin": {
    "nc-tools-mcp": "bin/nc-tools-mcp.mjs"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2"
  }
}
